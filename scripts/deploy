#!/usr/bin/env bash

set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project_directory="$script_directory/.."

install_dependencies=false
while getopts ":d" opt; do
  case $opt in
    d)
      install_dependencies=true
      ;;
    *)
      ;;
  esac
done

if ! command -v rsync &> /dev/null; then
  echo 'rsync is not installed on this computer. rsync is used to copy the application code to your device. Install it using the package manager you use with your OS.'
  exit 1
fi

if ! command -v circup &> /dev/null; then
  echo 'circup is not installed on this computer. circup is used to install CircuitPython dependencies on your device. Install it by following the instructions in the rshell repository at: https://github.com/adafruit/circup'
  exit 1
fi

echo 'Detecting your CircuitPython device...'
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS: Check /Volumes for CIRCUITPY
    device_path="/Volumes/CIRCUITPY"
    if [ ! -d "$device_path" ]; then
        echo 'Could not detect a connected CircuitPython device. Make sure your device is flashed with CircuitPython and connected to your computer with a USB data cable.'
        exit 1
    fi
elif [[ "$OSTYPE" == "linux"* ]]; then
    # Linux: Check /media/$USER for CIRCUITPY
    device_path="/media/$USER/CIRCUITPY"
    if [ ! -d "$device_path" ]; then
        # Also check /run/media/$USER for CIRCUITPY (for some Linux distros)
        device_path="/run/media/$USER/CIRCUITPY"
        if [ ! -d "$device_path" ]; then
            echo 'Could not detect a connected CircuitPython device. Make sure your device is flashed with CircuitPython and connected to your computer with a USB data cable.'
            exit 1
        fi
    fi
else
    echo "Unsupported operating system: $OSTYPE"
    exit 1
fi
echo "Found device at $device_path"

if [ $install_dependencies = true ] || \
   [ ! -d "$device_path/lib" ] || \
   [ -z "$(ls -A "$device_path/lib")" ]; then
  echo 'Installing dependencies...'
  circup install --requirement "$project_directory/requirements.txt"
  echo 'Finished installing dependencies'
fi

echo 'Copying application code...'

rsync_excludes=(
  --include='/._*' --exclude="/.*"
  --exclude="/boot_out.txt" --exclude="/lib/"
  --exclude="/log.txt"
)
# Exclude settings.toml only if it doesn't exist in src/
if [ ! -f "$project_directory/src/settings.toml" ]; then
  rsync_excludes+=(--exclude="/settings.toml")
  echo 'Preserving existing settings.toml on device (src/settings.toml not found in repository)'
else
  echo 'Overwriting settings.toml on device with src/settings.toml from repository'
fi

rsync --verbose --recursive --delete --checksum \
  "${rsync_excludes[@]}" \
  "$project_directory/src/" "$device_path"
echo 'Finished copying application code'
